{% comment %}
    Section: Product Showcase
{% endcomment %}

<div class="product-showcase" id="showcase">
  <div class="container-limited">
    <div class="product-showcase__content">
      <h2 class="--all-caps"
          data-aos="fade-right"
          data-aos-delay="200">{{ section.settings.heading }}</h2>
      <p data-aos="fade-right"
         data-aos-delay="300">{{ section.settings.description }}</p>
      <p class="product-showcase__price"
         data-aos="fade-right"
         data-aos-delay="200">{{ section.settings.price }}</p>
      <p class="product-showcase__includes"
         data-aos="fade-right"
         data-aos-delay="250">{{ section.settings.includes }}</p>
      <p class="product-showcase__color"
         data-aos="fade-right"
         data-aos-delay="300">{{ section.settings.color_label }} {{ section.settings.color }}</p>
      <div class="product-showcase__ring-guide"
           data-aos="fade-right"
           data-aos-delay="400">
        <a href="{{ section.settings.ring_guide_link }}"
           class="--all-caps"
           title="{{ section.settings.ring_guide_title }}">{{ section.settings.ring_guide_text }}</a>
      </div>
      <div class="product-showcase__buttons"
           data-aos="fade-right"
           data-aos-delay="400">
        <a href="{{ section.settings.buy_now_link }}"
           class="button button--filled"
           data-aos="fade-right"
           data-aos-delay="500">{{ section.settings.buy_now_text }}</a>
      </div>
      <div class="accordion"
           data-aos="fade-right"
           data-aos-delay="200">
        <div class="accordion__wrapper"
             id="js-accordion"
             data-accordion="closed">
          <button class="accordion__triggers"
                  aria-expanded="false"
                  aria-controls="accordion-content"
                  title="{{ section.settings.accordion_toggle_title }}">
            <span class="accordion__text --all-caps">{{ section.settings.accordion_title }}</span>
            <span class="accordion__expander">+</span>
          </button>
          <div class="accordion__content"
               id="accordion-content"
               aria-hidden="true">
            <ul>
              {% for item in section.blocks %}
                {% if item.type == 'kit_item' %}
                  <li>{{ item.settings.item_text }}</li>
                {% endif %}
              {% endfor %}
            </ul>
            <span>{{ section.settings.accordion_note }}</span>
          </div>
        </div>
      </div>
      <div class="product-showcase__footnote"
           data-aos="fade-right"
           data-aos-delay="200">
        <span class="--all-caps">{{ section.settings.footnote_heading }}</span>
        <div class="product-showcase__footnote-links">
            <a href="{{ section.settings.footnote_link1 }}" 
               class="--all-caps"
               title="{{ section.settings.footnote_title1 }}">{{ section.settings.footnote_text1 }}</a>
            <a href="{{ section.settings.footnote_link2 }}" 
               class="--all-caps"
               title="{{ section.settings.footnote_title2 }}">{{ section.settings.footnote_text2 }}</a>
        </div>
      </div>
    </div>
    <div class="slider splide"
         id="js-simple-slider"
         data-aos="fade-in"
         data-aos-delay="50">
      <div class="splide__track">
        <div class="slider__slides splide__list">
          {% for block in section.blocks %}
            {% if block.type == 'product_showcase_slide' %}
              <div class="slider__slide splide__slide{% if forloop.first %} is-active{% endif %}">
                <img src="{{ block.settings.product_slide_image | image_url: width: 900, height: 900 }}"
                     height=""
                     width=""
                     class="product-showcase__image"
                     alt="{{ block.settings.slide_alt }}" />
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      <div class="slider__arrow --left">
        <button title="{{ section.settings.slider_arrow_left_title }}">
          <svg width="47"
               height="20"
               viewBox="0 0 47 20"
               fill="none"
               xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1L23.5 19L46 1" stroke="#D9D9D9"/>
          </svg>
        </button>
      </div>
      <div class="slider__arrow --right">
        <button title="{{ section.settings.slider_arrow_right_title }}">
          <svg width="47"
               height="20"
               viewBox="0 0 47 20"
               fill="none"
               xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1L23.5 19L46 1" stroke="#D9D9D9"/>
          </svg>
        </button>
      </div>
      <div class="slider__pagination"
           data-aos="fade-up"
           data-aos-delay="150">
        {% assign slide_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'product_showcase_slide' %}
            {% assign slide_count = slide_count | plus: 1 %}
            <button class="slider__pagination-dot{% if slide_count == 1 %} --current{% endif %}"
                    title="{{ section.settings.slider_pagination_title }} {{ slide_count }}"></button>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    function loadSpline() {
        const debug = false;
        const splineScript = document.createElement('script');
        splineScript.src = "{{ 'splide-4.1.4.min.js' | asset_url }}";
        splineScript.onload = function () {
            if (debug) console.log('Splide script loaded.');
            initializeSplide();
        };
        document.body.appendChild(splineScript);

        const splineStylesheet = document.createElement('link');
        splineStylesheet.rel = 'stylesheet';
        splineStylesheet.href = "{{ 'splide-4.1.4.min.css' | asset_url }}";
        document.head.appendChild(splineStylesheet);
    }
    function initializeSplide() {
        function splideSlider(sliderId) {
            const debug = false;
            const sliderElement = document.getElementById(sliderId);

            if (debug) console.log(`Initializing slider: ${sliderId}`, sliderElement);

            if (!sliderElement) {
                console.error(`Slider with ID "${sliderId}" not found.`);
                return;
            }

            const leftArrow = sliderElement.querySelector('.slider__arrow.--left button');
            const rightArrow = sliderElement.querySelector('.slider__arrow.--right button');
            const paginationDots = Array.from(sliderElement.querySelectorAll('.slider__pagination-dot'));

            if (debug) {
                console.log('Left Arrow:', leftArrow);
                console.log('Right Arrow:', rightArrow);
                console.log('Pagination Dots:', paginationDots);
            }

            const splide = new Splide(sliderElement, {
                type: 'slide',
                perPage: 1,
                perMove: 1,
                gap: '20px',
                arrows: false,
                pagination: false,
                drag: true,
                keyboard: true,
                breakpoints: {
                    768: {
                        perPage: 1,
                        gap: '10px',
                    },
                },
            });

            leftArrow.addEventListener('click', () => {
                if (debug) console.log('Left arrow clicked');
                splide.go('<');
            });

            rightArrow.addEventListener('click', () => {
                if (debug) console.log('Right arrow clicked');
                splide.go('>');
            });

            paginationDots.forEach((dot, index) => {
                dot.addEventListener('click', () => {
                    if (debug) console.log(`Pagination dot ${index + 1} clicked`);
                    splide.go(index);
                });

                splide.on('move', (current) => {
                    if (debug) console.log(`Slider moved to index: ${current}`);
                    paginationDots.forEach((dot, idx) => {
                        dot.classList.toggle('--current', idx === current);
                    });
                });
            });

            splide.mount();
            if (debug) console.log('Splide mounted successfully');
        }

        splideSlider('js-simple-slider');
    }
    loadSpline();

    function accordionExpand(elementId) {
      const accordion = document.getElementById(elementId);

      if (accordion) {
        const triggers = accordion.querySelectorAll('.accordion__triggers');
        const content = accordion.querySelector('.accordion__content');

        triggers.forEach(trigger => {
          trigger.setAttribute('aria-expanded', 'false');
          content.setAttribute('aria-hidden', 'true');

          trigger.addEventListener('click', () => {
            const isOpen = accordion.getAttribute('data-accordion') === 'opened';

            accordion.setAttribute('data-accordion', isOpen ? 'closed' : 'opened');

            trigger.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
            content.setAttribute('aria-hidden', isOpen ? 'true' : 'false');

            accordion.classList.toggle('--opened', !isOpen);
          });
        });
      }
    }
    accordionExpand('js-accordion');
  });
</script>

