{% comment %}
    Section: Warranty & Returns Policy
{% endcomment %}

<div class="warranty">
    <div class="container-limited --flex-column">
        <div class="warranty__content --flex-column">
            <h1 class="--all-caps"
                data-aos="fade-up"
                data-aos-delay="100">{{ section.settings.heading }}</h1>
            {% for block in section.blocks %}
                {% case block.type %}
                {% when 'rich_content' %}
                    <div data-aos="fade-up" 
                         data-aos-delay="200">
                        {{ block.settings.content }}
                    </div>
                {% endcase %}
            {% endfor %}
        </div>
    </div>
</div>

{% schema %}
{
  "name": "Warranty & Returns Policy",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Zugu “In Case of Death” Case<br/>Warranty & Returns Policy"
    }
  ],
  "blocks": [
    {
      "type": "rich_content",
      "name": "Rich Text Content",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>This is a rich text block. You can add lists, paragraphs, and more here:</p><ul><li>List Item 1</li><li>List Item 2</li></ul>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Default"
    }
  ]
}
{% endschema %}
